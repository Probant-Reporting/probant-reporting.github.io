---
// Les films de l'outil (src/content/<langue>/_videos.json). Un film = une section avec son ancre (/videos/#audit).
// Les fichiers sont dans public/videos/ ; ils se refont avec qa/video-shots.mjs.
// Un film est muet : son texte doit donc exister ailleurs que dans l'image (WCAG 1.2.1, contenu vidéo seul). Les
// légendes sont incrustées dans l'image, et la même suite d'étapes est portée par la page, lue par aria-describedby :
// elle ne s'affiche pas (décision de Florent du 24/11, le bloc dépliant alourdissait la page).
// Rien ne démarre tout seul : un film ne part qu'au clic. Le grand bouton de lecture est posé par le script.
import Icon from "./Icon.astro";
import { fichier, donnees } from "../lib/content";
import { nom } from "../lib/pages";
const { lang } = Astro.props;
const v = donnees(lang, "videos");
const duree = (n: number) => v.durationLabel.replace("{n}", String(n));
---
<div class="page large films"><div class="wrap">
  <h1>{nom(v.title)}</h1>

  {v.clips.map((c: any) => (
    <section class="film" id={c.slug} aria-labelledby={`${c.slug}-t`} data-lecture={nom(v.play)}>
      <h2 id={`${c.slug}-t`}>{nom(c.title)}</h2>
      <p class="film-duree"><Icon name="clock" />{duree(c.seconds)}</p>
      <div class="film-cadre">
        <video class="film-video" controls playsinline preload="none"
               poster={fichier(`videos/${c.slug}.webp`)}
               width="1280" height="940"
               aria-labelledby={`${c.slug}-t`} aria-describedby={`${c.slug}-etapes`}>
          <source src={fichier(`videos/${c.slug}.mp4`)} type="video/mp4" />
        </video>
      </div>
      {/* la suite des étapes, pour qui ne voit pas le film : présente dans la page, jamais affichée */}
      <div class="sr" id={`${c.slug}-etapes`}>
        <p>{nom(v.stepsLabel)}</p>
        <ol>{c.steps.map((s: string) => <li>{s}</li>)}</ol>
      </div>
      <p class="film-plein" data-variante>{nom(v.fullscreenHint)}</p>
    </section>
  ))}
</div></div>

<script>
  import "../scripts/films.js";
</script>
