---
// Une page de contenu ou un guide, écrit en Markdown (src/content/<langue>/pages/*.md ou guides/*.md).
import { chemin, site } from "../lib/content";
import { pagesDe, nom, titre } from "../lib/pages";
import Icon from "./Icon.astro";
const { lang, kind, slug } = Astro.props;
const p = pagesDe(kind, lang).find((x) => x.slug === slug)!;
const { Content } = p;
const g = site(lang).guidesUi;
---
<div class="page"><div class="wrap prose">
  {kind === "guides" && <p class="fil"><a href={chemin("guides", lang)}>{g.title}</a></p>}
  <h1>{titre(p.fm.title)}</h1>
  {p.fm.who && <p class="lead">{nom(p.fm.who)}</p>}
  {kind === "pages" && p.fm.description && <p class="lead">{nom(p.fm.description)}</p>}
  <Content />
  {kind === "guides" && (
    <nav class="autres-guides" aria-label={g.all}><p>{g.all}</p><ul>{pagesDe("guides", lang).map((x) => <li><a href={chemin(`guides/${x.slug}`, lang)} aria-current={x.slug === slug ? "page" : undefined}>{nom(x.fm.title)}</a></li>)}</ul></nav>
  )}
</div></div>
