---
// L'accueil de la documentation : une phrase d'introduction, puis les pages par groupe. La description de chaque page
// vient de la table tenue dans le site (src/content/<langue>/_doc_descriptions.json) : les pages elles-mêmes sont
// copiées depuis l'outil, et leur extrait automatique ne dit pas à quoi sert la page.
import { chemin, site, donnees } from "../lib/content";
import { pagesDe, nom } from "../lib/pages";
const { lang } = Astro.props;
const t = site(lang).docsUi;
const docs = pagesDe("docs", lang).filter((d) => d.slug !== "index");
const groupes = [...new Set(docs.map((x) => x.fm.group))];
const descriptions = donnees(lang, "doc_descriptions").descriptions;
---
<div class="page large"><div class="wrap">
  <h1>{t.title}</h1>
  {t.lead && <p class="lead">{nom(t.lead)}</p>}
  {groupes.map((g) => (
    <section class="docs-bloc" aria-labelledby={`g-${g.replace(/\W+/g, "-")}`}>
      <h2 id={`g-${g.replace(/\W+/g, "-")}`}>{t.groups[g] || g}</h2>
      <ul class="cartes-liens">{docs.filter((x) => x.fm.group === g).map((x) => <li><a href={chemin(`docs/${x.slug}`, lang)}><b>{nom(x.fm.title)}</b>{descriptions[x.slug] && <span class="desc">{nom(descriptions[x.slug])}</span>}</a></li>)}</ul>
    </section>
  ))}
</div></div>
