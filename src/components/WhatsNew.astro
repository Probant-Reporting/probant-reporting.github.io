---
// « What's new » : une entrée par version de l'outil (src/content/<langue>/_changelog.json, voir src/lib/changelog.ts).
import { chemin, fluxRss, site, config } from "../lib/content";
import { versions, ancre, enLigne, dateLongue } from "../lib/changelog";
const { lang } = Astro.props;
const w = site(lang).whatsNew;
const groupes = (items: string[]) => {
  const sortie: { titre: string; items: string[] }[] = [{ titre: "", items: [] }];
  for (const i of items) { const m = /^\*\*([^*]+)\*\*$/.exec(i.trim()); if (m) sortie.push({ titre: m[1], items: [] }); else sortie[sortie.length - 1].items.push(i); }
  return sortie.filter((g) => g.titre || g.items.length);
};
const lien = (u: string) => (u.startsWith("/") ? chemin(u.replace(/^\/|\/$/g, ""), lang) : u);
---
<div class="page"><div class="wrap prose">
  <h1>{w.title}</h1>
  <p class="lead">{w.lead}</p>
  <p class="suivre"><a href={fluxRss(lang)}>{w.rss}</a> · <a href={`${config.repo}/releases`} rel="noopener">{w.releases}</a> · <a href={chemin("get", lang)}>{w.get}</a></p>
  {/* une version = une partie repliable ; la plus récente est ouverte. Une ancre (#v1-0-0) ouvre sa version
      (src/scripts/ui.js). */}
  {versions(lang).map((v, i) => (
    <details class="version repli repli-section" id={ancre(v.version)} open={i === 0}>
      <summary><span class="version-titre"><h2 id={`${ancre(v.version)}-t`}>{w.version.replace("{version}", v.version)}</h2>
        <span class="version-date"><time datetime={v.date}>{dateLongue(v.date, lang)}</time></span></span></summary>
      {/* une version pas encore traduite s'affiche dans la langue par défaut, et la page le dit */}
      {v.lang !== lang && <p class="note">{w.untranslated}</p>}
      <div lang={v.lang !== lang ? v.lang : undefined}>
      {v.sections.map((s) => (
        <>
          {s.title && <h3>{s.title}</h3>}
          {/* une ligne entièrement en gras (« **Lire et partager** ») est un intertitre, pas une puce */}
          {groupes(s.items).map((g) => (
            <>
              {g.titre && <h4>{g.titre}</h4>}
              {g.items.length > 0 && <ul>{g.items.map((i) => <li set:html={enLigne(i, lien)} />)}</ul>}
            </>
          ))}
        </>
      ))}
      </div>
    </details>
  ))}
  <h2>{w.updateTitle}</h2>
  <p set:html={enLigne(w.updateText, lien)} />
</div></div>
