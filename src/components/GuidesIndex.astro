---
// Une seule page pour les guides par rôle et la documentation de l'équipe informatique (décision du 23/11/2026).
// Des cartes compactes, titre et phrase l'un sous l'autre : la liste à deux colonnes obligeait l'œil à sauter un
// grand vide. La documentation IT est d'un seul tenant, sans sous-sections (relecture de Florent du 25/11/2026).
import Icon from "./Icon.astro";
import { chemin, site, fichier } from "../lib/content";
import { pagesDe, nom } from "../lib/pages";
const { lang } = Astro.props;
const g = site(lang).guidesUi;
const t = site(lang).docsUi;
const docs = pagesDe("docs", lang).filter((d) => d.slug !== "index");
const descriptions = (await import("../lib/content")).donnees(lang, "doc_descriptions").descriptions;
---
<div class="page large guides-index"><div class="wrap">
  <h1>{g.title}</h1>

  <section aria-labelledby="g-roles">
    <h2 id="g-roles">{g.rolesTitle}</h2>
    <p class="pdf-lien"><a href={fichier(`pdf/probant-guides-${lang}.pdf`)} download><Icon name="download" />{g.pdf}<span class="sr">{" "}{g.pdfGuides}</span></a></p>
    <ul class="guides-cartes">
      {pagesDe("guides", lang).map((x) => (
        <li><a href={chemin(`guides/${x.slug}`, lang)}>
          <b>{nom(x.fm.title)}</b>
          <span class="qui">{nom(x.fm.who)}</span>
          <span>{nom(x.fm.summary || x.fm.description)}</span>
        </a></li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="g-it">
    <h2 id="g-it">{t.title}</h2>
    <p class="guides-lead">{nom(t.lead)}</p>
    <p class="pdf-lien"><a href={fichier(`pdf/probant-it-documentation-${lang}.pdf`)} download><Icon name="download" />{g.pdf}<span class="sr">{" "}{g.pdfDocs}</span></a></p>
    <ul class="guides-cartes">
      {docs.map((x) => (
        <li><a href={chemin(`docs/${x.slug}`, lang)}>
          <b>{nom(x.fm.title)}</b>
          {descriptions[x.slug] && <span>{nom(descriptions[x.slug])}</span>}
        </a></li>
      ))}
    </ul>
  </section>
</div></div>
