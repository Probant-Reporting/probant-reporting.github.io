---
// Une page de la documentation : le titre sur toute la largeur, puis le menu à gauche, l'article, le sommaire à droite.
// Sur téléphone : le titre, le menu replié, l'article. Contenu : src/content/<langue>/docs/*.md (synchronisé depuis le
// dépôt de l'outil, npm run sync).
import Icon from "./Icon.astro";
import { site, chemin, fichier } from "../lib/content";
import { pagesDe, nom, titre } from "../lib/pages";
const { lang, slug } = Astro.props;
const t = site(lang).docsUi;
const docs = pagesDe("docs", lang);
const i = docs.findIndex((d) => d.slug === slug), d = docs[i];
const lien = (s: string) => chemin(s === "index" ? "docs" : `docs/${s}`, lang);
const groupes = [...new Set(docs.map((x) => x.fm.group))];
const toc = d.headings.filter((h) => h.depth === 2);
const prec = docs[i - 1], suiv = docs[i + 1];
const { Content } = d;
const autres = pagesDe("pages", lang).filter((x) => ["security", "changelog"].includes(x.slug));
---
<div class="docs wrap">
  <header class="docs-titre">
    <p class="fil"><a href={chemin("guides", lang)}>{site(lang).guidesUi.title}</a></p>
    <h1>{titre(d.fm.title)}</h1>
    <p class="pdf-lien"><a href={fichier(`pdf/probant-it-documentation-${lang}.pdf`)} download><Icon name="download" />{site(lang).guidesUi.pdf}<span class="sr">{" "}{site(lang).guidesUi.pdfDocs}</span></a></p>
  </header>
  {/* Le même menu deux fois, jamais ensemble : replié (details) sous 960 px, déplié au-delà. Celui qui ne sert pas est
      en display:none, donc absent pour le clavier et les lecteurs d'écran. Aucun JavaScript. */}
  {["etroit", "large"].map((forme) => {
    const liste = (
      <>
        {groupes.map((g) => (
          <><p class="docs-groupe">{t.groups[g] || g}</p>
          <ul>{docs.filter((x) => x.fm.group === g).map((x) => <li><a href={lien(x.slug)} aria-current={x.slug === slug ? "page" : undefined}>{nom(x.fm.title)}</a></li>)}</ul></>
        ))}
        <p class="docs-groupe">{t.more}</p>
        <ul>{autres.map((x) => <li><a href={chemin(x.slug, lang)}>{nom(x.fm.title)}</a></li>)}</ul>
      </>
    );
    return <nav class={`docs-menu docs-menu-${forme}`} aria-label={t.menu}>{forme === "etroit" ? <details><summary>{t.pages}</summary>{liste}</details> : liste}</nav>;
  })}
  <article class="docs-article prose">
    <Content />
    <p class="docs-source">{t.source.replace("{source}", d.fm.source)}</p>
    <nav class="docs-suite" aria-label={`${t.previous} / ${t.next}`}>
      {prec ? <a href={lien(prec.slug)}><span>{t.previous}</span>{nom(prec.fm.title)}</a> : <span></span>}
      {suiv && <a href={lien(suiv.slug)} class="suivant"><span>{t.next}</span>{nom(suiv.fm.title)}</a>}
    </nav>
  </article>
  {toc.length > 1 && (
    <nav class="docs-toc" aria-label={t.onThisPage}><p>{t.onThisPage}</p><ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>
  )}
</div>
